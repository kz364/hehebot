#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

# Amp's base image supplies Node and npm; this repository has no exact version pin.
echo "Checking the orb's Node toolchain"
node --input-type=module -e '
  import { readFileSync } from "node:fs";
  const minimum = JSON.parse(readFileSync("package.json", "utf8")).engines.node;
  const [major, minor] = process.versions.node.split(".").map(Number);
  if (major < 22 || (major === 22 && minor < 16)) {
    throw new Error(`Node ${minimum} is required; found ${process.version}`);
  }
  console.log(`Node ${process.version}`);
'
npm --version

echo "Installing checksum-pinned age for offline backup contracts"
time bash scripts/setup-age.sh

# The measured warm install takes about three seconds. Use npm's cache rather
# than a custom fingerprint that could silently preserve incomplete dependencies.
echo "Installing locked dependencies (using the restored npm cache when available)"
time npm ci --prefer-offline --no-audit --no-fund

# Generate ignored binding types, without login or cloud operations.
export WRANGLER_SEND_METRICS=false
echo "Generating local Worker types"
time npm run types

# Explicit opt-in: the Swift compiler archive is about 1 GiB. This only enables
# Foundation policy tests in Linux; it cannot build or render the macOS app.
if [[ "${HEHEBOT_SWIFT_POLICY_TESTS:-0}" == 1 ]]; then
  echo "Installing pinned Swift for portable client policy tests"
  time bash macos/scripts/setup-linux-swift.sh
fi
