{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hehebot.invalid/schemas/contracts.json",
  "title": "Owner command v1",
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "skillBody": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "when_to_use": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "inputs_access": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 500 }, "maxItems": 32 },
        "steps": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 2000 }, "minItems": 1, "maxItems": 100 },
        "decision_rules": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 1000 }, "maxItems": 50 },
        "validation": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 1000 }, "minItems": 1, "maxItems": 50 },
        "output": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "failure_handling": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 1000 }, "minItems": 1, "maxItems": 50 },
        "approval_boundaries": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 1000 }, "minItems": 1, "maxItems": 50 },
        "references": {
          "type": "array", "maxItems": 4,
          "items": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "maxLength": 80, "pattern": "^[a-z0-9][a-z0-9._-]{0,63}\\.(md|txt)$" },
              "text": { "type": "string", "minLength": 1, "maxLength": 16000 }
            },
            "required": ["name", "text"]
          }
        },
        "contains_private_facts": { "const": false }
      },
      "required": ["name","description","when_to_use","inputs_access","steps","decision_rules","validation","output","failure_handling","approval_boundaries","contains_private_facts"]
    },
    "skillPropose": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "schema_version": { "const": 1 }, "type": { "const": "skill.propose" },
        "payload": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "proposal_id": { "$ref": "#/$defs/uuid" }, "skill_id": { "$ref": "#/$defs/uuid" },
            "expected_skill_revision": { "type": "integer", "minimum": 0 }, "body": { "$ref": "#/$defs/skillBody" },
            "provenance": { "type": "object", "additionalProperties": false, "properties": { "kind": { "enum": ["owner","task","notes","file","url","import","model"] }, "source_ref": { "type": "string", "minLength": 1, "maxLength": 1000 } }, "required": ["kind","source_ref"] },
            "executable_files_changed": { "type": "boolean" }
          },
          "required": ["proposal_id","skill_id","expected_skill_revision","body","provenance","executable_files_changed"]
        }
      }, "required": ["schema_version","type","payload"]
    },
    "skillProposeFromTask": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "schema_version": { "const": 1 }, "type": { "const": "skill.propose_from_task" },
        "payload": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "proposal_id": { "$ref": "#/$defs/uuid" }, "skill_id": { "$ref": "#/$defs/uuid" },
            "expected_skill_revision": { "type": "integer", "minimum": 0 },
            "source_run_id": { "$ref": "#/$defs/uuid" },
            "expected_attempt": { "type": "integer", "minimum": 1 },
            "body": { "$ref": "#/$defs/skillBody" }
          },
          "required": ["proposal_id","skill_id","expected_skill_revision","source_run_id","expected_attempt","body"]
        }
      }, "required": ["schema_version","type","payload"]
    },
    "skillReview": {
      "type": "object", "additionalProperties": false,
      "properties": { "schema_version": { "const": 1 }, "type": { "const": "skill.review" }, "payload": { "type": "object", "additionalProperties": false, "properties": { "proposal_id": { "$ref": "#/$defs/uuid" }, "expected_proposal_revision": { "type": "integer", "minimum": 1 }, "decision": { "enum": ["approve","reject"] } }, "required": ["proposal_id","expected_proposal_revision","decision"] } },
      "required": ["schema_version","type","payload"]
    },
    "skillEnable": {
      "type": "object", "additionalProperties": false,
      "properties": { "schema_version": { "const": 1 }, "type": { "const": "skill.enable" }, "payload": { "type": "object", "additionalProperties": false, "properties": { "skill_id": { "$ref": "#/$defs/uuid" }, "expected_skill_revision": { "type": "integer", "minimum": 1 }, "persona_id": { "$ref": "#/$defs/uuid" }, "enabled": { "type": "boolean" } }, "required": ["skill_id","expected_skill_revision","persona_id","enabled"] } },
      "required": ["schema_version","type","payload"]
    },
    "skillRun": {
      "type": "object", "additionalProperties": false,
      "properties": { "schema_version": { "const": 1 }, "type": { "const": "skill.run" }, "payload": { "type": "object", "additionalProperties": false, "properties": { "skill_id": { "$ref": "#/$defs/uuid" }, "expected_skill_revision": { "type": "integer", "minimum": 1 }, "persona_id": { "$ref": "#/$defs/uuid" }, "expected_persona_revision": { "type": "integer", "minimum": 1 }, "text": { "type": "string", "minLength": 1, "maxLength": 32768 } }, "required": ["skill_id","expected_skill_revision","persona_id","expected_persona_revision","text"] } },
      "required": ["schema_version","type","payload"]
    },
    "skillDelete": {
      "type": "object", "additionalProperties": false,
      "properties": { "schema_version": { "const": 1 }, "type": { "const": "skill.delete" }, "payload": { "type": "object", "additionalProperties": false, "properties": { "id": { "$ref": "#/$defs/uuid" }, "expected_revision": { "type": "integer", "minimum": 1 } }, "required": ["id","expected_revision"] } },
      "required": ["schema_version","type","payload"]
    },
    "skillRestore": {
      "type": "object", "additionalProperties": false,
      "properties": { "schema_version": { "const": 1 }, "type": { "const": "skill.restore" }, "payload": { "type": "object", "additionalProperties": false, "properties": { "proposal_id": { "$ref": "#/$defs/uuid" }, "skill_id": { "$ref": "#/$defs/uuid" }, "expected_skill_revision": { "type": "integer", "minimum": 1 }, "source_revision": { "type": "integer", "minimum": 1 } }, "required": ["proposal_id","skill_id","expected_skill_revision","source_revision"] } },
      "required": ["schema_version","type","payload"]
    },
    "pushSubscribe": {
      "type": "object", "additionalProperties": false,
      "properties": { "schema_version": { "const": 1 }, "type": { "const": "push.subscribe" }, "payload": { "type": "object", "additionalProperties": false, "properties": {
        "endpoint": { "type": "string", "format": "uri", "pattern": "^https://", "minLength": 1, "maxLength": 2048 },
        "keys": { "type": "object", "additionalProperties": false, "properties": {
          "p256dh": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,256}$" },
          "auth": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" }
        }, "required": ["p256dh","auth"] }
      }, "required": ["endpoint","keys"] } },
      "required": ["schema_version","type","payload"]
    },
    "pushUnsubscribe": {
      "type": "object", "additionalProperties": false,
      "properties": { "schema_version": { "const": 1 }, "type": { "const": "push.unsubscribe" }, "payload": { "type": "object", "additionalProperties": false, "properties": {
        "endpoint": { "type": "string", "format": "uri", "pattern": "^https://", "minLength": 1, "maxLength": 2048 }
      }, "required": ["endpoint"] } },
      "required": ["schema_version","type","payload"]
    }
  },
  "oneOf": [
    {
      "type":"object","additionalProperties":false,
      "properties": {
        "schema_version":{"const":1},"type":{"const":"owner-alpha.activate"},
        "payload":{"type":"object","additionalProperties":false,"properties":{"transition_id":{"$ref":"#/$defs/uuid"},"envelope_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}},"required":["transition_id","envelope_sha256"]}
      },"required":["schema_version","type","payload"]
    },
    {
      "type":"object","additionalProperties":false,
      "properties": {
        "schema_version":{"const":1},"type":{"const":"question.close"},
        "payload": {
          "type":"object","additionalProperties":false,
          "properties": {
            "question_id":{"$ref":"#/$defs/uuid"},
            "expected_revision":{"type":"integer","minimum":1,"maximum":9007199254740990},
            "confirm_stopped_closure":{"const":true}
          },"required":["question_id","expected_revision","confirm_stopped_closure"]
        }
      },"required":["schema_version","type","payload"]
    },
    {
      "type":"object","additionalProperties":false,
      "properties": {
        "schema_version":{"const":1},"type":{"const":"question.answer"},
        "payload": {
          "type":"object","additionalProperties":false,
          "properties": {
            "question_id":{"$ref":"#/$defs/uuid"},
            "expected_revision":{"type":"integer","minimum":1,"maximum":9007199254740990},
            "answers":{
              "type":"object","minProperties":1,"maxProperties":3,
              "propertyNames":{"type":"string","minLength":1,"maxLength":128},
              "additionalProperties":{
                "type":"object","additionalProperties":false,
                "properties":{"answers":{"type":"array","maxItems":1,"items":{"type":"string","maxLength":2000}}},
                "required":["answers"]
              }
            }
          },"required":["question_id","expected_revision","answers"]
        }
      },"required":["schema_version","type","payload"]
    },
    {
      "type":"object","additionalProperties":false,
      "properties": {
        "schema_version":{"const":1},"type":{"const":"roster.set"},
        "payload": {
          "type":"object","additionalProperties":false,
          "properties": {
            "expected_revision":{"type":"integer","minimum":0,"maximum":9007199254740990},
            "sections":{"type":"array","maxItems":20,"items":{
              "type":"object","additionalProperties":false,
              "properties":{
                "id":{"$ref":"#/$defs/uuid"},"name":{"type":"string","minLength":1,"maxLength":80},
                "persona_ids":{"type":"array","maxItems":200,"uniqueItems":true,"items":{"$ref":"#/$defs/uuid"}},
                "collapsed":{"type":"boolean"}
              },"required":["id","name","persona_ids","collapsed"]
            }},
            "hidden_persona_ids":{"type":"array","maxItems":200,"uniqueItems":true,"items":{"$ref":"#/$defs/uuid"}}
          },"required":["expected_revision","sections","hidden_persona_ids"]
        }
      },"required":["schema_version","type","payload"]
    },
    {
      "type":"object","additionalProperties":false,
      "properties": {
        "schema_version":{"const":1},"type":{"const":"run.recover"},
        "payload": {
          "type":"object","additionalProperties":false,
          "properties": {
            "run_id":{"$ref":"#/$defs/uuid"},"expected_attempt":{"type":"integer","minimum":1},
            "release_resources":{"const":true}
          },
          "required":["run_id","expected_attempt","release_resources"]
        }
      },
      "required":["schema_version","type","payload"]
    },
    {
      "type":"object","additionalProperties":false,
      "properties": {
        "schema_version":{"const":1},"type":{"const":"effect.reconcile"},
        "payload": {
          "type":"object","additionalProperties":false,
          "properties": {
            "run_id":{"$ref":"#/$defs/uuid"},"effect_id":{"$ref":"#/$defs/uuid"},
            "expected_attempt":{"type":"integer","minimum":1},
            "expected_request_digest":{"type":"string","minLength":1,"maxLength":256},
            "outcome":{"enum":["confirmed","failed"]},
            "evidence_ref":{"type":"string","pattern":"^[A-Za-z0-9:._-]{1,128}$"}
          },
          "required":["run_id","expected_attempt","effect_id","expected_request_digest","outcome","evidence_ref"]
        }
      },
      "required":["schema_version","type","payload"]
    },
    {
      "type":"object","additionalProperties":false,
      "properties": {
        "schema_version":{"const":1},"type":{"const":"run.steer"},
        "payload": {
          "type":"object","additionalProperties":false,
          "properties": {
            "run_id":{"$ref":"#/$defs/uuid"},
            "expected_attempt":{"type":"integer","minimum":1},
            "text":{"type":"string","minLength":1,"maxLength":32768}
          },
          "required":["run_id","expected_attempt","text"]
        }
      },
      "required":["schema_version","type","payload"]
    },
    {
      "type":"object","additionalProperties":false,
      "properties": {
        "schema_version":{"const":1},"type":{"const":"budget.set"},
        "payload": {
          "type":"object","additionalProperties":false,
          "properties": {
            "expected_revision":{"type":"integer","minimum":0},
            "enabled":{"type":"boolean"},
            "monthly_cap_cents":{"type":"integer","minimum":1,"maximum":1000000000},
            "optional_routine_ids":{"type":"array","maxItems":20,"uniqueItems":true,"items":{"$ref":"#/$defs/uuid"}}
          },
          "required":["expected_revision","enabled","monthly_cap_cents","optional_routine_ids"]
        }
      },
      "required":["schema_version","type","payload"]
    },
    {
      "type":"object","additionalProperties":false,
      "properties": {
        "schema_version":{"const":1},"type":{"const":"budget.override"},
        "payload": {
          "type":"object","additionalProperties":false,
          "properties":{"run_id":{"$ref":"#/$defs/uuid"},"expected_revision":{"type":"integer","minimum":1}},
          "required":["run_id","expected_revision"]
        }
      },
      "required":["schema_version","type","payload"]
    },
    {
      "type": "object", "additionalProperties": false,
      "properties": {
        "schema_version": { "const": 1 }, "type": { "enum": ["routine.run", "routine.delete"] },
        "payload": { "type": "object", "additionalProperties": false,
          "properties": { "id": { "$ref": "#/$defs/uuid" }, "expected_revision": { "type": "integer", "minimum": 1 } },
          "required": ["id", "expected_revision"] }
      }, "required": ["schema_version", "type", "payload"]
    },
    { "$ref": "#/$defs/skillPropose" },
    { "$ref": "#/$defs/skillProposeFromTask" },
    { "$ref": "#/$defs/skillReview" },
    { "$ref": "#/$defs/skillEnable" },
    { "$ref": "#/$defs/skillRun" },
    { "$ref": "#/$defs/skillDelete" },
    { "$ref": "#/$defs/skillRestore" },
    { "$ref": "#/$defs/pushSubscribe" },
    { "$ref": "#/$defs/pushUnsubscribe" },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "type": {
          "const": "message.send"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "conversation_id": {
              "type": "string",
              "format": "uuid"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32768
            }
          },
          "required": [
            "conversation_id",
            "text"
          ]
        }
      },
      "required": [
        "schema_version",
        "type",
        "payload"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "type": {
          "const": "persona.put"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "expected_revision": {
              "type": "integer",
              "minimum": 0
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "role": {"type":"string","maxLength":200},
            "instructions": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16000
            },
            "tool_policy_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              },
              "maxItems": 32,
              "uniqueItems": true
            },
            "archived": {
              "type": "boolean"
            }
          },
          "required": [
            "id",
            "expected_revision",
            "name",
            "instructions",
            "tool_policy_ids",
            "archived"
          ]
        }
      },
      "required": [
        "schema_version",
        "type",
        "payload"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "type": {
          "const": "room.put"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "expected_revision": {
              "type": "integer",
              "minimum": 0
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "member_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              },
              "maxItems": 8,
              "uniqueItems": true,
              "minItems": 1
            },
            "default_responder_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "id",
            "expected_revision",
            "name",
            "member_ids",
            "default_responder_id"
          ]
        }
      },
      "required": [
        "schema_version",
        "type",
        "payload"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "type": {
          "const": "routine.put"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "expected_revision": {
              "type": "integer",
              "minimum": 0
            },
            "persona_id": {
              "type": "string",
              "format": "uuid"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "instructions": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16000
            },
            "schedule": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "cron": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "timezone": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    }
                  },
                  "required": [
                    "cron",
                    "timezone"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "trigger_source_id": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ]
            },
            "enabled": {
              "type": "boolean"
            },
            "policy": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "misfire": {
                  "enum": [
                    "coalesce",
                    "skip",
                    "replay"
                  ]
                },
                "overlap": {
                  "enum": [
                    "queue_one",
                    "skip"
                  ]
                },
                "max_replay": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 3
                },
                "max_lateness_seconds": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 86400
                }
              },
              "required": [
                "misfire",
                "overlap",
                "max_replay",
                "max_lateness_seconds"
              ]
            },
            "action_policy_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              },
              "maxItems": 32,
              "uniqueItems": true
            }
          },
          "required": [
            "id",
            "expected_revision",
            "persona_id",
            "name",
            "instructions",
            "schedule",
            "trigger_source_id",
            "enabled",
            "policy",
            "action_policy_ids"
          ],
          "oneOf": [
            {
              "properties": {
                "schedule": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "cron": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "timezone": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    }
                  },
                  "required": [
                    "cron",
                    "timezone"
                  ]
                },
                "trigger_source_id": {
                  "type": "null"
                }
              }
            },
            {
              "properties": {
                "schedule": {
                  "type": "null"
                },
                "trigger_source_id": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "type",
        "payload"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "type": {
          "const": "memory.put"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "expected_revision": {
              "type": "integer",
              "minimum": 0
            },
            "scope": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": [
                    "global",
                    "persona",
                    "routine",
                    "skill"
                  ]
                },
                "id": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "uuid"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "kind",
                "id"
              ],
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "global"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "id": {
                        "type": "null"
                      }
                    }
                  },
                  "else": {
                    "properties": {
                      "id": {
                        "type": "string",
                        "format": "uuid"
                      }
                    }
                  }
                }
              ]
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16000
            },
            "source_event_id": {
              "type": "string",
              "format": "uuid"
            },
            "expires_at": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            },
            "sensitivity": {
              "enum": [
                "ordinary",
                "sensitive"
              ]
            },
            "explicit_constraint": {
              "type": "boolean"
            },
            "summary": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "schema_version": { "const": 1 },
                "source_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                "text": { "type": "string", "minLength": 1, "maxLength": 2000 }
              },
              "required": ["schema_version", "source_sha256", "text"]
            }
          },
          "required": [
            "id",
            "expected_revision",
            "scope",
            "text",
            "source_event_id",
            "expires_at",
            "sensitivity"
          ]
        }
      },
      "required": [
        "schema_version",
        "type",
        "payload"
      ]
    },
    {
