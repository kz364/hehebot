{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "runtimeIdentity": {
      "type":"object","additionalProperties":false,
      "properties":{"epoch":{"type":"integer","minimum":1},"boot_id":{"type":"string","format":"uuid"}},
      "required":["epoch","boot_id"]
    },
    "effectIntent": {
      "type":"object","additionalProperties":false,
      "properties": {
        "id":{"type":"string","format":"uuid"},
        "run_id":{"type":"string","format":"uuid"},
        "attempt":{"type":"integer","minimum":1},
        "action_key":{"type":"string","minLength":1,"maxLength":256},
        "classification":{"enum":["read_only","idempotent","mutation"]},
        "authorization_ref":{"type":"string","minLength":1,"maxLength":256},
        "request_digest":{"type":"string","minLength":1,"maxLength":256},
        "provider_idempotency_key":{"anyOf":[{"type":"string","minLength":1,"maxLength":256},{"type":"null"}]}
      },
      "required":["id","run_id","attempt","action_key","classification","authorization_ref","request_digest","provider_idempotency_key"]
    }
  },
  "oneOf": [
    {
      "type":"object","additionalProperties":false,
      "properties": {
        "type":{"const":"root-child-effect-intent"},
        "payload": {
          "type":"object","additionalProperties":false,
          "properties": {
            "identity":{"$ref":"#/$defs/runtimeIdentity"},
            "root_run_id":{"type":"string","format":"uuid"},
            "root_attempt":{"type":"integer","minimum":1},
            "effect":{"$ref":"#/$defs/effectIntent"},
            "resources":{"type":"array","minItems":0,"maxItems":8,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-zA-Z0-9:._/-]{1,256}$"}}
          },
          "required":["identity","root_run_id","root_attempt","effect","resources"],
          "allOf":[{
            "if":{"properties":{"effect":{"properties":{"classification":{"enum":["idempotent","mutation"]}}}}},
            "then":{"properties":{"resources":{"minItems":1}}}
          }]
        }
      },
      "required":["type","payload"]
    },
    {
      "type":"object","additionalProperties":false,
      "properties": {
        "type":{"const":"root-child-effect-result"},
        "payload": {
          "type":"object","additionalProperties":false,
          "properties": {
            "identity":{"$ref":"#/$defs/runtimeIdentity"},
            "root_run_id":{"type":"string","format":"uuid"},
            "root_attempt":{"type":"integer","minimum":1},
            "run_id":{"type":"string","format":"uuid"},
            "attempt":{"type":"integer","minimum":1},
            "effect_id":{"type":"string","format":"uuid"},
            "status":{"enum":["dispatched","confirmed","failed","outcome_unknown"]},
            "receipt":{"type":["object","null"]}
          },
          "required":["identity","root_run_id","root_attempt","run_id","attempt","effect_id","status","receipt"]
        }
      },
      "required":["type","payload"]
    },
