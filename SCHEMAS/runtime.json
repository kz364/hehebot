    "tokenCounts": {
      "type":"object","additionalProperties":false,
      "properties": {
        "inputTokens":{"type":"integer","minimum":0,"maximum":9007199254740991},
        "cachedInputTokens":{"type":"integer","minimum":0,"maximum":9007199254740991},
        "cacheWriteInputTokens":{"type":"integer","minimum":0,"maximum":9007199254740991},
        "outputTokens":{"type":"integer","minimum":0,"maximum":9007199254740991},
        "reasoningOutputTokens":{"type":"integer","minimum":0,"maximum":9007199254740991},
        "totalTokens":{"type":"integer","minimum":0,"maximum":9007199254740991}
      },"required":["inputTokens","cachedInputTokens","cacheWriteInputTokens","outputTokens","reasoningOutputTokens","totalTokens"]
    },
    "runtimeIdentity": {
      "type":"object","additionalProperties":false,
      "properties":{"epoch":{"type":"integer","minimum":1},"boot_id":{"type":"string","format":"uuid"}},
      "required":["epoch","boot_id"]
    },
    "effectIntent": {
      "type":"object","additionalProperties":false,
      "properties": {
        "id":{"type":"string","format":"uuid"},
        "run_id":{"type":"string","format":"uuid"},
        "attempt":{"type":"integer","minimum":1},
        "action_key":{"type":"string","minLength":1,"maxLength":256},
        "classification":{"enum":["read_only","idempotent","mutation"]},
        "authorization_ref":{"type":"string","minLength":1,"maxLength":256},
        "request_digest":{"type":"string","minLength":1,"maxLength":256},
        "provider_idempotency_key":{"anyOf":[{"type":"string","minLength":1,"maxLength":256},{"type":"null"}]}
      },
      "required":["id","run_id","attempt","action_key","classification","authorization_ref","request_digest","provider_idempotency_key"]
    }
  },
  "oneOf": [
    {
      "type":"object","additionalProperties":false,
      "properties": {
        "type":{"const":"token-usage"},
        "payload": {
          "type":"object","additionalProperties":false,
          "properties": {
            "identity":{"$ref":"#/$defs/runtimeIdentity"},
            "run_id":{"type":"string","format":"uuid"},
            "attempt":{"type":"integer","minimum":1,"maximum":9007199254740991},
            "native_ref":{"type":"string","minLength":1,"maxLength":256},
            "version":{"type":"integer","minimum":1,"maximum":9007199254740991},
            "usage":{"type":"object","additionalProperties":false,"properties":{
              "total":{"$ref":"#/$defs/tokenCounts"},"last":{"$ref":"#/$defs/tokenCounts"},
              "modelContextWindow":{"type":["integer","null"],"minimum":0,"maximum":9007199254740991}
