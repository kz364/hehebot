{
  "name": "hehebot-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Remote-only macOS shell for the Hehebot portal",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "build:mac": "electron-builder --mac",
    "pack:mac": "electron-builder --mac dir"
  },
  "devDependencies": {
    "electron": "39.0.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.hehebot.portal",
    "productName": "Hehebot Portal",
    "copyright": "Copyright © 2026 Hehebot contributors",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": null,
      "target": [
        "dmg",
        "zip"
      ]
    }
  }
}
